{
  "manifest_version": 3,
  "name": "密码生成器",
  "description": "在本地安全生成密码与 sk- API Key，一键复制，随时刷新。",
  "version": "1.0.0",
  "permissions": ["storage", "clipboardWrite"],
  "action": {"default_popup": "popup.html", "default_title": "密码生成器", "default_icon": {"16":"icons/icon16.png","32":"icons/icon32.png"}},
  "icons": {"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"},
  "content_security_policy": {"extension_pages":"script-src 'self'; object-src 'none'; connect-src 'none'"}
}
